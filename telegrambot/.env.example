# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Security: Comma-separated list of allowed Telegram user IDs (e.g. 12345678,87654321).
# By default, access is denied to everyone if this is empty.
TELEGRAM_ALLOWED_USERS=

# Explicitly allow all users (NOT recommended for production).
TELEGRAM_ALLOW_ALL_USERS=false

# Docker health server configuration
BOT_HEALTH_HOST=0.0.0.0
BOT_HEALTH_PORT=8081
BOT_SERVICE_NAME=mpxraspberrypibot
